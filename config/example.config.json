{
  "server": {
    "host": "127.0.0.1",
    "port": 5746,
    "auth": "bearer",
    "mcpAuth": "bearer",
    "allowedHttpOrigins": [],
    "allowedChromeExtensionIds": [],
    "maxRequestBytes": 1048576
  },
  "dataDir": "~/.relu-ai-bridge",
  "connectors": {
    "enabled": true,
    "websocketPath": "/relu/ws",
    "allowInsecureHttp": false,
    "requestTimeoutMs": 30000,
    "maxWebSocketMessageBytes": 1048576,
    "maxContextBytes": 65536,
    "maxResultBytes": 524288,
    "maxSessions": 64,
    "policyEpoch": 1,
    "services": []
  },
  "perfetto": {
    "enabled": true,
    "tokenEnv": "RELU_PERFETTO_CONNECTOR_TOKEN",
    "websocketPath": "/perfetto/ws",
    "allowedOrigins": [
      "http://127.0.0.1:10000",
      "http://localhost:10000"
    ],
    "requestTimeoutMs": 30000,
    "maxConcurrentRequests": 32,
    "maxWebSocketMessageBytes": 2097152,
    "maxQueryBytes": 65536,
    "maxQueryRows": 5000,
    "maxClients": 32,
    "maxSessions": 100,
    "allowedPluginIds": ["io.company.RELUPerfettoBridge"],
    "allowedSqlFunctions": [
      "abs", "avg", "cast", "coalesce", "count", "date", "datetime",
      "dense_rank", "extract_arg", "first_value", "glob",
      "ifnull", "iif", "instr", "julianday", "lag",
      "last_value", "lead", "length", "like", "likely", "lower", "ltrim",
      "max", "min", "nth_value", "ntile", "nullif", "percent_rank",
      "rank", "round", "row_number", "rtrim",
      "sign", "strftime", "str_split", "substr", "substring", "sum", "time",
      "total", "trim", "typeof", "unicode", "unixepoch", "unlikely", "upper"
    ]
  },
  "roots": [
    {
      "id": "project",
      "path": "/absolute/path/to/company/project",
      "readOnly": true,
      "protectedPaths": [
        ".git/**",
        ".github/workflows/**",
        "**/.env",
        "**/.env.*",
        "**/.npmrc",
        "**/.netrc",
        "**/.pypirc",
        "**/.yarnrc*",
        "**/.git-credentials",
        "**/.ssh/**",
        "**/.aws/**",
        "**/.kube/config",
        "**/.docker/config.json",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.jks",
        "**/*.keystore",
        "**/*secret*",
        "**/*credential*"
      ]
    }
  ],
  "permissions": {
    "read": true,
    "write": false,
    "commands": false,
    "sessions": true,
    "goalLoop": false,
    "multiAgent": false,
    "allowArbitraryCommands": false
  },
  "approvals": {
    "policy": "trusted_always",
    "allowPersistentGrants": true,
    "preapprovedScopes": []
  },
  "limits": {
    "maxReadBytes": 524288,
    "maxWriteBytes": 1048576,
    "maxSearchResults": 200,
    "maxCommandOutputBytes": 1048576,
    "commandTimeoutMs": 120000,
    "commandKillGraceMs": 2000,
    "commandSessionTtlMs": 60000,
    "maxConcurrentCommands": 4,
    "maxConcurrentCommandsPerRoot": 2,
    "sessionRetentionDays": 30,
    "maxWorkers": 4,
    "maxGoalTurns": 50
  },
  "commandProfiles": {},
  "goal": {
    "mode": "local",
    "continuePrompt": "Continue working toward the saved goal. Verify remaining work and do not stop until the goal is complete. When it is fully complete, end the final answer with [GOAL_COMPLETE].",
    "completionMarkers": ["[GOAL_COMPLETE]", "[목표_완료]"]
  },
  "privacy": {
    "recordAudit": true,
    "recordSessions": false,
    "recordToolArguments": false,
    "recordToolResults": false,
    "maxRecordedResultBytes": 65536,
    "redactPatterns": [
      "(?i)bearer\\s+[a-z0-9._-]+",
      "(?i)(api[_-]?key|token|password|secret)\\s*[:=]\\s*[^\\s,;]+"
    ]
  }
}
