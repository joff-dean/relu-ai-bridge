{
  "id": "android-log-viewer",
  "displayName": "WPF Android Log Viewer",
  "tokenEnv": "RELU_ANDROID_LOG_VIEWER_TOKEN",
  "clientKinds": ["desktop"],
  "origins": [],
  "desktopAppIds": ["com.relu.AndroidLogViewer"],
  "bindingFields": ["logResourceId", "datasetRevision"],
  "executionGuardFields": ["logResourceId", "datasetRevision", "selectionId", "selectionRevision", "selection"],
  "contextSchema": {
    "type": "object",
    "properties": {
      "logResourceId": { "type": "string", "maxLength": 128 },
      "datasetRevision": { "type": "string", "maxLength": 128 },
      "selectionId": { "type": "string", "maxLength": 128 },
      "selectionRevision": { "type": "string", "maxLength": 128 },
      "selection": {
        "type": "object",
        "properties": {
          "startMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "endMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        },
        "required": ["startMs", "endMs"],
        "additionalProperties": false
      }
    },
    "required": ["logResourceId", "datasetRevision", "selectionId", "selectionRevision", "selection"],
    "additionalProperties": false
  },
  "capabilities": [
    {
      "name": "get_selection_stats",
      "description": "현재 선택 구간의 제한된 통계를 조회한다.",
      "transport": "desktop",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "durationMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "sampleCount": { "type": "integer", "minimum": 0, "maximum": 100000000 },
          "warningCount": { "type": "integer", "minimum": 0, "maximum": 100000000 },
          "errorCount": { "type": "integer", "minimum": 0, "maximum": 100000000 },
          "metrics": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "maxLength": 128 },
                "value": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
                "unit": { "type": "string", "maxLength": 64 }
              },
              "required": ["name", "value", "unit"],
              "additionalProperties": false
            }
          }
        },
        "required": ["durationMs", "sampleCount", "warningCount", "errorCount", "metrics"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_selection_series",
      "description": "현재 선택 구간의 downsample된 차트 series를 조회한다.",
      "transport": "desktop",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "maxPointsPerSeries": { "type": "integer", "minimum": 10, "maximum": 1000 }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "series": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "maxLength": 128 },
                "unit": { "type": "string", "maxLength": 64 },
                "points": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "properties": {
                      "timestampMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                      "value": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 }
                    },
                    "required": ["timestampMs", "value"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["name", "unit", "points"],
              "additionalProperties": false
            }
          }
        },
        "required": ["series"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_log_excerpt",
      "description": "현재 선택 구간에서 제한된 수의 로그 줄을 조회한다.",
      "transport": "desktop",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "maxLines": { "type": "integer", "minimum": 1, "maximum": 200 }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "timestampMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "level": { "type": "string", "maxLength": 32 },
                "tag": { "type": "string", "maxLength": 256 },
                "message": { "type": "string", "maxLength": 4000 }
              },
              "required": ["timestampMs", "level", "tag", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["lines"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_extracted_sections",
      "description": "WPF 분석기가 미리 추출한 제한된 텍스트 section을 조회한다.",
      "transport": "desktop",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sections": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "maxLength": 128 },
                "startMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "endMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "text": { "type": "string", "maxLength": 16000 }
              },
              "required": ["kind", "startMs", "endMs", "text"],
              "additionalProperties": false
            }
          }
        },
        "required": ["sections"],
        "additionalProperties": false
      }
    },
    {
      "name": "find_anomalies",
      "description": "WPF 분석기가 현재 선택 구간에서 찾은 이상 징후를 조회한다.",
      "transport": "desktop",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "anomalies": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "timestampMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "severity": { "type": "string", "maxLength": 32 },
                "summary": { "type": "string", "maxLength": 1000 },
                "evidence": {
                  "type": "array",
                  "maxItems": 20,
                  "items": { "type": "string", "maxLength": 2000 }
                }
              },
              "required": ["timestampMs", "severity", "summary", "evidence"],
              "additionalProperties": false
            }
          }
        },
        "required": ["anomalies"],
        "additionalProperties": false
      }
    }
  ]
}
