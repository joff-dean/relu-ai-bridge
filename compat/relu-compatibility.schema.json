{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RELU AI Bridge core and connector compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "release", "connectors"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "core_version", "scope"],
      "properties": {
        "id": {"const": "relu-ai-bridge"},
        "name": {"const": "RELU AI Bridge"},
        "core_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "scope": {"const": "company-internal-local-capability-ai-bridge"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_prefix", "immutable_ref_namespace"],
      "properties": {
        "tag_prefix": {"const": "relu-ai-bridge-v"},
        "immutable_ref_namespace": {"const": "refs/releases/relu-ai-bridge/"}
      }
    },
    "connectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "id", "name", "version", "contract", "manifest"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "id": {"type": "string"},
          "name": {"type": "string"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "contract": {"type": "string"},
          "manifest": {
            "type": "string",
            "pattern": "^connectors/[A-Za-z0-9._-]+\\.json$"
          }
        }
      }
    }
  }
}
