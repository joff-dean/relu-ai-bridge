{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RELU AI Bridge connector compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector",
    "public_baseline",
    "integration",
    "company_integration_policy",
    "security_policy"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "id", "name", "version", "adapter_contract", "compatible_relu_core_versions"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "id": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "adapter_contract": {"type": "string"},
        "compatible_relu_core_versions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
        }
      }
    },
    "public_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "release", "tag_ref", "tag_object_sha", "commit_sha", "short_commit"],
      "properties": {
        "repository": {"type": "string"},
        "release": {"type": "string"},
        "tag_ref": {"type": "string", "pattern": "^refs/tags/"},
        "tag_object_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "short_commit": {"type": "string", "pattern": "^[0-9a-f]{7,12}$"}
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "source_plugin_path",
        "source_adapter_path",
        "target_plugin_path",
        "target_adapter_path",
        "default_plugins_file",
        "enable_patch"
      ],
      "properties": {
        "plugin_id": {"type": "string", "minLength": 1},
        "source_plugin_path": {"type": "string", "minLength": 1},
        "source_adapter_path": {"type": "string", "minLength": 1},
        "target_plugin_path": {"type": "string", "minLength": 1},
        "target_adapter_path": {"type": "string", "minLength": 1},
        "default_plugins_file": {"type": "string", "minLength": 1},
        "enable_patch": {"type": "string", "minLength": 1}
      }
    },
    "company_integration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_scope",
        "exact_head_required",
        "company_adapter_must_be_external",
        "external_release_metadata_allowed"
      ],
      "properties": {
        "metadata_scope": {"const": "company-internal-only"},
        "exact_head_required": {"const": true},
        "company_adapter_must_be_external": {"const": true},
        "external_release_metadata_allowed": {"const": false}
      }
    },
    "security_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_source_allowed_in_external_repository",
        "company_trace_allowed_in_external_repository",
        "credential_allowed_in_release_bundle",
        "telemetry_allowed",
        "runtime_remote_code_loading_allowed"
      ],
      "properties": {
        "company_source_allowed_in_external_repository": {"const": false},
        "company_trace_allowed_in_external_repository": {"const": false},
        "credential_allowed_in_release_bundle": {"const": false},
        "telemetry_allowed": {"const": false},
        "runtime_remote_code_loading_allowed": {"const": false}
      }
    }
  }
}
