{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "caveats"],
  "properties": {
    "summary": {"type": "string", "maxLength": 8000},
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "explanation", "evidence"],
        "properties": {
          "title": {"type": "string", "maxLength": 200},
          "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
          "explanation": {"type": "string", "maxLength": 4000},
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "target", "startNs", "endNs", "trackUris"],
              "properties": {
                "label": {"type": "string", "maxLength": 100},
                "target": {"type": "string", "enum": ["current", "ref", "dut"]},
                "startNs": {"type": "string", "pattern": "^-?[0-9]+$", "maxLength": 128},
                "endNs": {"type": "string", "pattern": "^-?[0-9]+$", "maxLength": 128},
                "trackUris": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2048}}
              }
            }
          }
        }
      }
    },
    "caveats": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 1000}}
  }
}
